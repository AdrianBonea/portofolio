---
import Base from '../layouts/Base.astro';
import Brand from '../components/Brand.astro';
import Contact from '../components/Contact.astro';
import Terminal from '../components/Terminal.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { experience } from '../lib/experience';

// Rendered at build time, then refreshed in the browser so it stays right between deploys.
const { words } = experience();

const name = 'Adrian Bonea';
---

<Base
  title="Adrian Bonea — Software Developer"
  description={`Full-stack developer with ${words} years of building web and mobile products with React, Next.js, Node, Postgres and Expo.`}
>
  <div class="glow" aria-hidden="true"></div>
  <div class="wrap">
    <header class="top reveal" style="--d:0">
      <Brand />
      <nav>
        <a class="u" href="#contact">contact</a>
        <ThemeToggle />
      </nav>
    </header>

    <main>
      <section class="hero">
        <div class="intro">
          <p class="kicker reveal" style="--d:1"><span>~</span> / software developer</p>
          <h1 aria-label={name}>
            {
              // Letters animate one by one; each word stays unbreakable so narrow screens wrap between words.
              name.split(' ').map((word, w, words) => {
                const offset = words.slice(0, w).join(' ').length + (w ? 1 : 0);
                return (
                  <>
                    <span class="word" aria-hidden="true">
                      {word.split('').map((ch, i) => (
                        <span class="ch" style={`--c:${offset + i}`}>{ch}</span>
                      ))}
                    </span>
                    {w < words.length - 1 && ' '}
                  </>
                );
              })
            }
          </h1>
          <p class="lede reveal" style="--d:6">
            Full-stack developer with <span data-years="words">{words}</span> years of building web and mobile products — rooted in the frontend,
            comfortable all the way down to the database.
          </p>
        </div>

        <Terminal class="reveal" style="--d:4" />
      </section>

      <Contact />
    </main>

    <footer class="scroll-in">
      <span>© {new Date().getFullYear()} Adrian Mirel Bonea</span>
      <span>Bucharest, RO</span>
    </footer>
  </div>
</Base>

<script>
  import { refreshYears } from '../lib/experience';

  // Keep every years mention current even if the site hasn't been rebuilt in a while.
  refreshYears();

  // Reveal on scroll
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          e.target.classList.add('in');
          io.unobserve(e.target);
        }
      }
    },
    { threshold: 0.15 },
  );
  document.querySelectorAll('.scroll-in').forEach((el) => io.observe(el));

  // Soft glow following the pointer
  const glow = document.querySelector<HTMLElement>('.glow');
  if (glow && !matchMedia('(prefers-reduced-motion: reduce)').matches && matchMedia('(pointer: fine)').matches) {
    addEventListener('pointermove', (e) => {
      glow.style.setProperty('--x', `${e.clientX}px`);
      glow.style.setProperty('--y', `${e.clientY}px`);
      glow.classList.add('on');
    });
  }
</script>

<style>
  .wrap {
    position: relative;
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 32px;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }
  @media (max-width: 600px) {
    .wrap {
      padding: 0 20px;
    }
  }

  /* Pointer glow */
  .glow {
    position: fixed;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.6s;
    background: radial-gradient(600px circle at var(--x, 50%) var(--y, 30%), var(--glow), transparent 60%);
  }
  .glow.on {
    opacity: 1;
  }

  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 32px 0;
    font: 13px var(--mono);
    color: var(--muted);
  }
  nav {
    display: flex;
    align-items: center;
    gap: 20px;
  }
  nav a {
    padding: 12px 0;
  }

  .u {
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    transition:
      background-size 0.3s,
      color 0.2s;
  }
  .u:hover {
    background-size: 100% 1px;
    color: var(--fg);
  }

  main {
    flex: 1;
  }

  .hero {
    display: flex;
    flex-wrap: wrap;
    gap: 72px;
    align-items: flex-end;
    padding: 112px 0 128px;
  }
  @media (max-width: 600px) {
    .hero {
      gap: 48px;
      padding: 56px 0 80px;
    }
  }
  .intro {
    flex: 1 1 480px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .kicker {
    margin: 0;
    font: 13px var(--mono);
    letter-spacing: 0.04em;
    color: var(--muted);
  }
  .kicker span {
    color: var(--accent);
  }
  h1 {
    margin: 0;
    font-family: var(--mono);
    font-size: clamp(44px, 6.5vw, 80px);
    line-height: 1.04;
    letter-spacing: -0.045em;
    font-weight: 300;
  }
  .word {
    display: inline-block;
    white-space: nowrap;
  }
  .ch {
    display: inline-block;
    animation: char 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) both;
    animation-delay: calc(0.15s + var(--c) * 0.04s);
  }
  @keyframes char {
    from {
      opacity: 0;
      transform: translateY(0.4em);
      filter: blur(6px);
    }
  }
  .lede {
    margin: 0;
    max-width: 480px;
    font-size: 19px;
    line-height: 1.65;
    color: var(--muted);
  }

  footer {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    padding: 24px 0 calc(48px + env(safe-area-inset-bottom));
    font: 12px var(--mono);
    color: var(--muted);
  }
</style>
