---
import Base from '../layouts/Base.astro';

const email = 'hello@boneaadrian.dev';
const contacts = [
  { label: 'email', value: email, href: `mailto:${email}`, arrow: '→' },
  { label: 'linkedin', value: 'in/adrian-mirel-bonea', href: 'https://www.linkedin.com/in/adrian-mirel-bonea/', arrow: '↗' },
  { label: 'github', value: 'AdrianBonea', href: 'https://github.com/AdrianBonea', arrow: '↗' },
];

// Lines shown one by one in the hero terminal.
const lines = [
  { text: '$ stack --list', tone: 'dim' },
  { text: 'react  next.js  typescript', tone: 'out' },
  { text: 'node   postgres', tone: 'out' },
  { text: 'expo   github actions', tone: 'out' },
  { text: '$ experience', tone: 'dim' },
  { text: '4 years', tone: 'accent' },
];
---

<Base
  title="Adrian Bonea — Software Developer"
  description="Full-stack developer with four years of building web and mobile products with React, Next.js, Node, Postgres and Expo."
>
  <div class="wrap">
    <header class="top">
      <a href="#" class="brand">boneaadrian<span>.dev</span></a>
      <nav>
        <a class="u" href="#contact">contact</a>
        <button id="theme" type="button" aria-label="Toggle light or dark theme">dark</button>
      </nav>
    </header>

    <main>
      <section class="hero">
        <div class="intro fade">
          <p class="kicker"><span>~</span> / software developer</p>
          <h1>Adrian Bonea</h1>
          <p class="lede">
            Full-stack developer with four years of building web and mobile products — rooted in the frontend,
            comfortable all the way down to the database.
          </p>
        </div>

        <div class="term fade" aria-label="Terminal showing my stack and experience" role="img">
          <div class="term-bar" aria-hidden="true">
            <span class="dots"><i></i><i></i><i></i></span>
            <span>zsh</span>
          </div>
          <div class="term-body" aria-hidden="true">
            {lines.map((l, i) => <div class={`line ${l.tone}`} style={`--i:${i}`}>{l.text}</div>)}
            <span class="cursor"></span>
          </div>
        </div>
      </section>

      <section id="contact" class="contact">
        <div class="contact-head">
          <h2>Get in touch.</h2>
          <p>Open to new opportunities</p>
        </div>
        <ul>
          {
            contacts.map((c) => (
              <li>
                <a class="row" href={c.href} rel={c.href.startsWith('http') ? 'me noopener' : undefined}>
                  <span class="label">{c.label}</span>
                  <span class="value">{c.value}</span>
                  <span class="arr" aria-hidden="true">{c.arrow}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </main>

    <footer>
      <span>© {new Date().getFullYear()} Adrian Mirel Bonea</span>
      <span>Bucharest, RO</span>
    </footer>
  </div>
</Base>

<script>
  const btn = document.getElementById('theme') as HTMLButtonElement;
  const root = document.documentElement;
  const sync = () => (btn.textContent = root.dataset.theme === 'light' ? 'light' : 'dark');
  sync();
  btn.addEventListener('click', () => {
    const light = root.dataset.theme !== 'light';
    if (light) root.dataset.theme = 'light';
    else delete root.dataset.theme;
    try {
      localStorage.setItem('theme', light ? 'light' : 'dark');
    } catch {}
    sync();
  });
</script>

<style>
  .wrap {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 32px;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }
  @media (max-width: 600px) {
    .wrap {
      padding: 0 20px;
    }
  }

  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 32px 0;
    font: 13px var(--mono);
    color: var(--muted);
  }
  .brand {
    color: var(--fg);
  }
  .brand span {
    color: var(--accent);
  }
  nav {
    display: flex;
    align-items: center;
    gap: 20px;
  }
  nav a {
    padding: 12px 0;
  }
  #theme {
    height: 44px;
    padding: 0 4px;
    border: 0;
    background: none;
    color: var(--muted);
    font: 13px var(--mono);
    cursor: pointer;
  }
  #theme:hover {
    color: var(--fg);
  }

  .u {
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    transition: background-size 0.3s;
  }
  .u:hover {
    background-size: 100% 1px;
  }

  main {
    flex: 1;
  }

  .hero {
    display: flex;
    flex-wrap: wrap;
    gap: 72px;
    align-items: flex-end;
    padding: 112px 0 128px;
  }
  @media (max-width: 600px) {
    .hero {
      gap: 48px;
      padding: 56px 0 80px;
    }
  }
  .intro {
    flex: 1 1 480px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .kicker {
    margin: 0;
    font: 13px var(--mono);
    letter-spacing: 0.04em;
    color: var(--muted);
  }
  .kicker span {
    color: var(--accent);
  }
  h1 {
    margin: 0;
    font-family: var(--mono);
    font-size: clamp(44px, 6.5vw, 80px);
    line-height: 1.04;
    letter-spacing: -0.045em;
    font-weight: 300;
  }
  .lede {
    margin: 0;
    max-width: 480px;
    font-size: 19px;
    line-height: 1.65;
    color: var(--muted);
  }

  .term {
    flex: 1 1 340px;
    min-width: 0;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--panel);
    font: 13px/2 var(--mono);
    animation-delay: 0.2s;
  }
  .term-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 16px;
    border-bottom: 1px solid var(--line);
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  .dots {
    display: flex;
    gap: 6px;
  }
  .dots i {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    border: 1px solid var(--line);
  }
  .term-body {
    padding: 18px 20px 20px;
    min-height: 196px;
  }
  .line {
    white-space: pre-wrap;
    opacity: 0;
    animation: show 0.01s forwards;
    animation-delay: calc(0.5s + var(--i) * 0.38s);
  }
  .dim {
    color: var(--dim);
  }
  .out {
    color: var(--out);
  }
  .accent {
    color: var(--accent);
  }
  .cursor {
    display: inline-block;
    width: 7px;
    height: 15px;
    vertical-align: middle;
    background: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }

  .contact {
    display: flex;
    flex-direction: column;
    gap: 40px;
    padding: 56px 0 40px;
    border-top: 1px solid var(--line);
  }
  .contact-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 24px;
  }
  h2 {
    margin: 0;
    font-size: clamp(26px, 3.4vw, 36px);
    font-weight: 400;
    letter-spacing: -0.02em;
  }
  .contact-head p {
    margin: 0;
    font: 13px var(--mono);
    color: var(--muted);
  }
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
    font: 15px var(--mono);
    border-bottom: 1px solid var(--line);
  }
  .row {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 22px 0;
    border-top: 1px solid var(--line);
  }
  .label {
    width: 120px;
    flex-shrink: 0;
    color: var(--muted);
  }
  .value {
    flex: 1;
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .arr {
    color: var(--accent);
    transition: transform 0.25s;
  }
  .row:hover .arr {
    transform: translateX(4px);
  }
  @media (max-width: 600px) {
    .label {
      width: 80px;
    }
  }

  footer {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    padding: 24px 0 48px;
    font: 12px var(--mono);
    color: var(--muted);
  }

  .fade {
    animation: fade 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  @keyframes fade {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }
  @keyframes show {
    to {
      opacity: 1;
    }
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .line {
      opacity: 1;
    }
  }
</style>
